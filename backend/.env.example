# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL + PostGIS Database URL
# For local development:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/medlink
# For cloud deployment (Render, Supabase, Neon):
# DATABASE_URL=postgresql://user:password@cloud-host.com:5432/medlink?sslmode=require

# CORS Allowed Origin (set to frontend production URL when deployed)
CORS_ORIGIN=http://localhost:5173

# JWT Secret for 256-bit token authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
