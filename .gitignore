# ============================================================
# MedLink Git Ignore - Security & Build Exclusions
# ============================================================

# 1. Dependency Directories
node_modules/
*/node_modules/
package-lock.json.bak

# 2. Production Build Artifacts
dist/
*/dist/
build/
*/build/

# 3. Environment Variables & Secret Credentials (CRITICAL)
.env
.env.*
!.env.example
!*/.env.example
backend/.env
frontend/.env
*.env.local

# 4. Logs & Debug Traces
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & IDE Metadata
.DS_Store
Thumbs.db
desktop.ini
*/desktop.ini
**/*/desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Local Agent / System Generated Cache
.system_generated/
coverage/
*.tmp

# 7. Local Project Reports & Milestone Deliverables
Roadmap/
docs/
